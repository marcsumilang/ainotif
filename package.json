{
  "name": "notifai",
  "version": "1.0.0",
  "private": true,
  "description": "NotifAi - Privacy-first Android notification interception & financial intelligence",
  "scripts": {
    "adb-install": "node scripts/adb-install.js",
    "adb:install": "node scripts/adb-install.js",
    "adb:install:launch": "node scripts/adb-install.js --launch",
    "adb:devices": "node scripts/adb-install.js --devices",
    "adb:launch": "node scripts/adb-install.js --launch-only",
    "build:apk": "node scripts/build-android.js assembleDebug",
    "build:apk:release": "node scripts/build-android.js assembleRelease",
    "build:apk:acceptance": "node scripts/build-android-acceptance.js",
    "test:acceptance-config": "node scripts/test-android-acceptance-config.js",
    "build-and-install": "npm run build:apk && npm run adb-install",
    "dev:backend": "cd backend && pnpm dev",
    "dev:web": "cd web && pnpm dev"
  },
  "keywords": [
    "notifai",
    "android",
    "adb"
  ],
  "author": "Marc Jherico Sumilang",
  "license": "UNLICENSED"
}
