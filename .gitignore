# ==========================================
# AiNotif Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.local

# ------------------------------------------
# Operating System & Editor Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
*/.idea/
.vscode/
*/.vscode/
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# Backend (Node.js / TypeScript / pnpm / Drizzle)
# ------------------------------------------
node_modules/
*/node_modules/
dist/
*/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / test coverage
coverage/
.nyc_output/
*.tsbuildinfo

# Drizzle / DB migrations temp
.drizzle/

# ------------------------------------------
# Android & Gradle
# ------------------------------------------
# Built application files & packages
*.apk
*.aab
*.aar
*.dex
*.class

# Output and build directories
build/
*/build/
**/build/
bin/
gen/
out/

# Gradle files and caches
.gradle/
*/.gradle/
**/.gradle/
.kotlin/
*/.kotlin/
**/.kotlin/

# Local Android SDK / NDK configuration
local.properties

# Android Studio specific
.navigation/
captures/
.externalNativeBuild/
.cxx/
signing-report.txt
*.hprof

# Keystore and signing keys
*.keystore
*.jks

# Google Services / Firebase (keep private)
google-services.json
*/google-services.json

# Lint and profiling outputs
lint/
*/lint/
profile/
*/profile/
