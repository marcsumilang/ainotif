# Server Port
PORT=3000

# Google Gemini API Key (for Typesafe AI Transaction & Scam Classification)
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=

# Neon Database Connection String (PostgreSQL serverless)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Clerk Authentication Keys
# Find these in Clerk Dashboard > API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Development Mode: Set to "true" to allow test JWTs or mock authenticated users
DEV_MOCK_AUTH=true
