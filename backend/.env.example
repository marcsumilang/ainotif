# Server Port
PORT=3000

# OpenRouter API Key (Free models for AI Transaction & Scam Classification)
# Get your free key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OpenRouter Model ID (Defaults to openrouter/free to auto-route to available free models)
# Other free options include: google/gemma-4-31b-it:free, qwen/qwen3.8-27b:free, meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free

# Neon Database Connection String (PostgreSQL serverless)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Clerk Authentication Keys
# Find these in Clerk Dashboard > API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Development Mode: Set to "true" to allow test JWTs or mock authenticated users
DEV_MOCK_AUTH=true
